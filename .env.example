# Zulip PostgreSQL read-only connection.
# Use a dedicated role with SELECT-only access to the required zerver_* tables.
ZULIP_DB_DSN=postgresql://ntfy4zulip:change-me@127.0.0.1:5432/zulip
# Zulip Docker deployments commonly keep application tables in schema "zulip".
ZULIP_DB_SCHEMA=public

# Path to the Generic bot's zuliprc. Defaults to ./zuliprc.
# ZULIPRC_PATH=/srv/ntfy4zulip/zuliprc

# Internal endpoint used by ntfy4zulip for publishing. This may be a Docker DNS
# name and does not need a public FQDN.
NTFY_PUBLISH_URL=http://ntfy:80

# Optional external HTTPS URL shown to users by the onboarding bot.
# Leave unset until the ntfy server is reachable by end-user clients.
# NTFY_PUBLIC_URL=https://ntfy.company.example

# Backward compatibility: legacy NTFY_HOST is accepted as both publish + public URL
# when the new variables are not set.
# NTFY_HOST=https://ntfy.company.example

NTFY_AUTH_TOKEN=tk_change_me
NTFY_TOPIC_PREFIX=zulip

# Generate once and back it up. Changing this changes every user's topic.
# Example: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
TOPIC_SECRET=replace-with-at-least-32-random-bytes

# A message is considered for push in the minute bucket 3-4 minutes old.
NOTIFICATION_DELAY_MINUTES=3
POLL_INTERVAL_SECONDS=60
NTFY_CONCURRENCY=20
NTFY_TIMEOUT_SECONDS=10
MESSAGE_PREVIEW_CHARS=800

# Global ntfy priorities, shared by all users.
# 1=min, 2=low, 3=default, 4=high, 5=max.
# Baseline priorities by notification type (shared by every user).
NTFY_DEFAULT_PRIORITY=2
NTFY_MENTION_PRIORITY=4
NTFY_WILDCARD_MENTION_PRIORITY=3
NTFY_DM_PRIORITY=4
NTFY_GROUP_DM_PRIORITY=3
NTFY_TEST_PRIORITY=3

# Optional folder rules for channel messages only. Applied after type classification
# using max(type_priority, folder_priority): folders cannot lower importance.
# Folder names are case-insensitive; JSON syntax; one config for everyone.
# NTFY_FOLDER_PRIORITIES='{"Дежурство":5,"Новости":2,"Работа":4}'

# Bounds both PostgreSQL connection establishment and individual SQL statements.
DB_TIMEOUT_SECONDS=15
