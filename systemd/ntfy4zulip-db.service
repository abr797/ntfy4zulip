[Unit]
Description=ntfy4zulip DB-backed unread notification bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zulip-push
Group=zulip-push
WorkingDirectory=/opt/ntfy4zulip
EnvironmentFile=/opt/ntfy4zulip/.env
ExecStart=/opt/ntfy4zulip/.venv/bin/python /opt/ntfy4zulip/run_db.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
